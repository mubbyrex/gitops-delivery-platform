{
  "uid": "kestrel-settlement-worker",
  "title": "settlement-worker \u2014 is it healthy?",
  "description": "Indicators sourced from the cluster's record, because the run's own numbers die with it.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "kestrel-pay"
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "environment",
        "type": "custom",
        "query": "dev,staging",
        "current": {
          "text": "dev",
          "value": "dev"
        },
        "options": [
          {
            "text": "dev",
            "value": "dev",
            "selected": true
          },
          {
            "text": "staging",
            "value": "staging",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "How to read this",
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "This service **does not exist most of the time**. It runs for about thirty seconds, then exits. Absence is normal, so 'is it up' is not a question with a yes.\n\nEvery number here except the version comes from the **cluster's record of the runs**, not from the service. The service writes its outcome and duration in the instant before it exits, so a collector almost never reads them \u2014 its own duration gauge reports `0` while the cluster reports the true figure.\n\n**Time since last success** is the one to look at first: it is the only panel that treats *nothing happening* as a signal. A worker that silently stops being scheduled produces no failures and no errors \u2014 the numbers simply stop.\n\nNo panel declares a number too late or too long."
      }
    },
    {
      "type": "stat",
      "title": "Time since last success",
      "description": "The only indicator here that treats absence as a signal. Cannot tell 'never scheduled' from 'all runs failing'.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 5,
        "x": 10,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - max(kube_job_status_completion_time{namespace=\"$namespace\", job_name=~\"settlement-worker.*\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active runs",
      "description": "Should never exceed one. Not expected to vary -- present because an unmeasured guarantee is a belief.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 5,
        "x": 15,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_cronjob_status_active{cronjob=\"settlement-worker\", namespace=\"$namespace\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Version",
      "description": "Attribution, not health. Looked back over an hour on purpose: the pod is absent most of the time, so an instant read is blank between runs.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(count by (version) (max_over_time(settlement_worker_build_info{namespace=\"$namespace\"}[1h]))) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Runs retained, by outcome",
      "description": "Interrupted and failed are the same thing here: the cluster does not draw that distinction, though the service does.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_job_status_succeeded{namespace=\"$namespace\", job_name=~\"settlement-worker.*\"})",
          "legendFormat": "succeeded",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_job_status_failed{namespace=\"$namespace\", job_name=~\"settlement-worker.*\"})",
          "legendFormat": "failed",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Run duration",
      "description": "Saturation for a scheduled job is lateness, not capacity. A run approaching its own period is what makes overlap possible.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(kube_job_status_completion_time{namespace=\"$namespace\", job_name=~\"settlement-worker.*\"} - on(job_name) kube_job_status_start_time{namespace=\"$namespace\", job_name=~\"settlement-worker.*\"})",
          "legendFormat": "last run",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(time() - kube_cronjob_status_last_schedule_time{cronjob=\"settlement-worker\", namespace=\"$namespace\"})",
          "legendFormat": "since last schedule",
          "refId": "A"
        }
      ]
    }
  ]
}
