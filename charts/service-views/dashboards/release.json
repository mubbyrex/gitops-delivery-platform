     "expr": "(sum by (rollouts_pod_template_hash) (rate(payments_api_requests_total{namespace=\"$namespace\", path=\"/\", status!~\"2..\"}[2m])) or sum by (rollouts_pod_template_hash) (rate(payments_api_requests_total{namespace=\"$namespace\", path=\"/\"}[2m])) * 0) / sum by (rollouts_pod_template_hash) (rate(payments_api_requests_total{namespace=\"$namespace\", path=\"/\"}[2m]))",
     "refId": "A",
