  {
   "type": "timeseries",
   "title": "Share of requests failing, by version",
   "description": "The red line is the gate's 1% limit. A flat zero is the expected and correct reading: neither failure switch can make this service return an error on a real request, which is exactly why the floor on requests a second exists. Written to report a true zero rather than an empty panel \u2014 'no failures' and 'no data' look identical otherwise.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 20
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       },
       {
        "color": "red",
        "value": 0.01
       }
      ]
     },
     "custom": {
      "drawStyle": "line",
      "lineInterpolation": "smooth",
      "lineWidth": 2,
      "fillOpacity": 8,
      "gradientMode": "opacity",
      "showPoints": "never",
      "spanNulls": true,
      "pointSize": 5,
      "axisSoftMin": 0,
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "scaleDistribution": {
