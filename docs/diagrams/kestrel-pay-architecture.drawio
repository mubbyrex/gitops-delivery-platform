eight="790" width="840" x="30" y="330" as="geometry" /></mxCell><mxCell id="n13" parent="la" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;dashed=1;dashPattern=6 6;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;" value="Argo CD syncs a Rollout" vertex="1"><mxGeometry height="50" width="480" x="170" y="50" as="geometry" /></mxCell><mxCell id="n14" parent="la" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#0e7490;dashed=1;dashPattern=6 6;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;" value="New version runs alongside the stable one" vertex="1"><mxGeometry height="50" width="480" x="170" y="130" as="geometry" /></mxCell><mxCell id="n15" parent="la" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#0e7490;dashed=1;dashPattern=6 6;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;" value="Weighted route sends it 5% of live traffic" vertex="1"><mxGeometry height="50" width="480" x="170" y="210" as="geometry" /></mxCell><mxCell id="n16" parent="la" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;dashed=0;dashPattern=6 6;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;" value="GATE · automated analysis&#10;error rate and p95 latency over several minutes,&#10;against the stable version" vertex="1"><mxGeometry height="80" width="580" x="120" y="290" as="geometry" /></mxCell><mxCell id="n17" parent="la" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;dashed=1;dashPattern=6 6;fontSize=10;fontColor=#1f2937;align=center;verticalAlign=middle;" value="Abort&#10;back to&#10;stable" vertex="1"><mxGeometry height="60" width="90" x="730" y="300" as="geometry" /></mxCell><mxCell id="n18" parent="la" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#0e7490;dashed=1;dashPattern=6 6;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;" value="Widen 25% → 50% → 100%, re-measuring each step" vertex="1"><mxGeometry height="50" width="480" x="170" y="410" as="geometry" /></mxCell><mxCell id="n19" parent="la" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#0e7490;dashed=1;dashPattern=6 6;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;" value="Promote — the new version becomes stable" vertex="1"><mxGeometry height="50" width="480" x="170" y="490" as="geometry" /></mxCell><mxCell id="n20" parent="la" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#374151;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;Why this is safe here.&lt;/b&gt; Two versions can serve at once without interfering. Exposure is metered, so 5% of traffic is at most 5% of the harm. And damage shows up in seconds, while exposure is still small." vertex="1"><mxGeometry height="110" width="780" x="30" y="570" as="geometry" /></mxCell><mxCell id="e21" edge="1" parent="la" source="n13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;exitDx=0;exitDy=0;strokeColor=#0e7490;fontColor=#0e7490;fontSize=11;endArrow=classic;endFill=1;dashed=0;dashPattern=6 6;" target="n14" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e22" edge="1" parent="la" source="n14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;exitDx=0;exitDy=0;strokeColor=#0e7490;fontColor=#0e7490;fontSize=11;endArrow=classic;endFill=1;dashed=0;dashPattern=6 6;" target="n15" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e23" edge="1" parent="la" source="n15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;exitDx=0;exitDy=0;strokeColor=#0e7490;fontColor=#0e7490;fontSize=11;endArrow=classic;endFill=1;dashed=0;dashPattern=6 6;" target="n16" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e24" edge="1" parent="la" source="n16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;exitDx=0;exitDy=0;strokeColor=#0e7490;fontColor=#0e7490;fontSize=11;endArrow=classic;endFill=1;dashed=0;dashPattern=6 6;" target="n18" value="pass"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e25" edge="1" parent="la" source="n18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;exitDx=0;exitDy=0;strokeColor=#0e7490;fontColor=#0e7490;fontSize=11;endArrow=classic;endFill=1;dashed=0;dashPattern=6 6;" target="n19" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e26" edge="1" parent="la" source="n16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;exitDx=0;exitDy=0;strokeColor=#b91c1c;fontColor=#b91c1c;fontSize=11;endArrow=classic;endFill=1;dashed=0;dashPattern=6 6;" target="n17" value="fail"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e27" edge="1" parent="1" source="n6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;exitDx=0;exitDy=0;strokeColor=#0e7490;fontColor=#0e7490;fontSize=11;endArrow=classic;endFill=1;dashed=0;dashPattern=6 6;" target="n13" value="stateless workload"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lb" parent="1" style="rounded=0;whiteSpace=wrap;html=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;fillColor=#fdf7ff;strokeColor=#7e22ce;dashed=0;dashPattern=6 6;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=13;fontColor=#7e22ce;" value="settlement-worker  —  released by exclusion" vertex="1"><mxGeometry height="790" width="828" x="910" y="330" as="geometry" /></mxCell><mxCell id="n28" parent="lb" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;dashed=1;dashPattern=6 6;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;" value="Argo CD syncs the worker manifest" vertex="1"><mxGeometry height="50" width="500" x="120.5" y="55" as="geometry" /></mxCell><mxCell id="n29" parent="lb" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;dashed=0;dashPattern=6 6;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;" value="GATE · is a settlement run in flight?&#10;releasing mid-run would put two versions on one batch" vertex="1"><mxGeometry height="80" width="541" x="100" y="130" as="geometry" /></mxCell><mxCell id="n30" parent="lb" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;dashed=1;dashPattern=6 6;fontSize=10;fontColor=#1f2937;align=center;verticalAlign=middle;" value="Wait&#10;hold the&#10;change" vertex="1"><mxGeometry height="100" width="80" x="730" y="120" as="geometry" /></mxCell><mxCell id="n31" parent="lb" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7e22ce;dashed=1;dashPattern=6 6;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;" value="Replace the single version — never two at once" vertex="1"><mxGeometry height="50" width="500" x="120.5" y="257" as="geometry" /></mxCell><mxCell id="n32" parent="lb" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;dashed=0;dashPattern=6 6;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;" value="GATE · exactly one version active&#10;the schedule refuses to overlap runs" vertex="1"><mxGeometry height="70" width="553" x="94" y="343" as="geometry" /></mxCell><mxCell id="n33" parent="lb" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7e22ce;dashed=1;dashPattern=6 6;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;" value="The next scheduled run uses the new version" vertex="1"><mxGeometry height="50" width="500" x="120.5" y="461" as="geometry" /></mxCell><mxCell id="n34" parent="lb" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#374151;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;Why canarying is wrong here.&lt;/b&gt; Two versions reading the same unsettled payments both decide a payout is owed and the merchant is paid twice. There is no small slice, and the money has left before anyone knows." vertex="1"><mxGeometry height="110" width="780" x="30" y="570" as="geometry" /></mxCell><mxCell id="e35" edge="1" parent="lb" source="n28" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;exitDx=0;exitDy=0;strokeColor=#7e22ce;fontColor=#7e22ce;fontSize=11;endArrow=classic;endFill=1;dashed=0;dashPattern=6 6;" target="n29" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e36" edge="1" parent="lb" source="n29" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;exitDx=0;exitDy=0;strokeColor=#b91c1c;fontColor=#b91c1c;fontSize=11;endArrow=classic;endFill=1;dashed=0;dashPattern=6 6;" target="n30" value="yes"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e37" edge="1" parent="lb" source="n30" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;exitDx=0;exitDy=0;strokeColor=#b91c1c;fontColor=#b91c1c;fontSize=11;endArrow=classic;endFill=1;dashed=0;dashPattern=6 6;" target="n28" value="retry"><mxGeometry relative="1" x="-0.5403" as="geometry"><mxPoint as="offset" /><Array as="points"><mxPoint x="761.65" y="75.06" /></Array></mxGeometry></mxCell><mxCell id="e38" edge="1" parent="lb" source="n29" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;exitDx=0;exitDy=0;strokeColor=#7e22ce;fontColor=#7e22ce;fontSize=11;endArrow=classic;endFill=1;dashed=0;dashPattern=6 6;" target="n31" value="no"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e39" edge="1" parent="lb" source="n31" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;ortho